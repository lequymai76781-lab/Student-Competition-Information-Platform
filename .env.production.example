# 生产/Beta环境必须提供；禁止默认值
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://user:password@host:5432/competition_intelligence
APP_SECRET=replace-with-random-secret-of-at-least-24-chars
BETA_INVITE_CODE=replace-with-invite-code
# 正式域名
FRONTEND_URL=https://competition.example.com
BACKEND_URL=https://competition.example.com
BACKEND_CORS_ORIGINS=https://competition.example.com
LOG_DIR=/www/wwwroot/competition/data/logs
# 管理员首次初始化：python backend/scripts/bootstrap_admin.py
# ADMIN_EMAIL=your-email
# ADMIN_PASSWORD=your-strong-password
