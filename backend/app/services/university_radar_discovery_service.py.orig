    max_department_entries: int = 16
    max_department_feeds: int = 12
    max_list_pages_per_department: int = 4
    max_department_articles: int = 90
    max_candidate_urls: int = 180
    max_page_fetches: int = 130
    max_known_entry_probes: int = 9
    max_internal_search_pages: int = 3


@dataclass(slots=True)
class DiscoveryFunnel:
    discovered_by_source: dict[str, set[str]] = field(default_factory=dict)
    fetched_urls: set[str] = field(default_factory=set)
    successful_urls: set[str] = field(default_factory=set)
    failed_urls: dict[str, str] = field(default_factory=dict)
    skipped_urls: set[str] = field(default_factory=set)
    parsed_urls: set[str] = field(default_factory=set)
    candidate_urls: set[str] = field(default_factory=set)
    lead_urls: set[str] = field(default_factory=set)
    entry_urls: set[str] = field(default_factory=set)
    department_urls: set[str] = field(default_factory=set)
    search_result_urls: set[str] = field(default_factory=set)

    def discover(self, url: str, source: str, *, entry: bool = False, search_result: bool = False) -> None:
        self.discovered_by_source.setdefault(source, set()).add(url)
        if entry:
            self.entry_urls.add(url)
            self.department_urls.add(url)
        if search_result:
            self.search_result_urls.add(url)

    def fetched(self, url: str, result: Any) -> None:
        self.fetched_urls.add(url)
        if isinstance(result, FetchResult):
            self.successful_urls.add(url)
            return
        status = getattr(result, "status_code", None)
        detail = getattr(result, "message", "") or "fetch_failed"
        self.failed_urls[url] = f"HTTP {status}" if status else detail

    def as_dict(self) -> dict[str, Any]:
        failures = list(self.failed_urls.values())
        discovered = set().union(*self.discovered_by_source.values()) if self.discovered_by_source else set()
        return {
            "entry_urls_discovered": len(self.entry_urls),
            "department_urls_discovered": len(self.department_urls),
            "search_results_discovered": len(self.search_result_urls),
            "urls_discovered": len(discovered),
            "urls_fetched": len(self.fetched_urls),
            "urls_skipped": len(self.skipped_urls),
            "urls_failed": len(self.failed_urls),
            "fetch_success": len(self.successful_urls),
            "http_403": sum("403" in item for item in failures),
            "http_412": sum("412" in item for item in failures),
            "timeout": sum("timeout" in item.lower() or "timed out" in item.lower() or "超时" in item for item in failures),
            "parsed_pages": len(self.parsed_urls),
            "competition_candidate_pages": len(self.candidate_urls),
            "valid_competition_leads": len(self.lead_urls),
            "discovery_sources": {
                source: len(urls) for source, urls in sorted(self.discovered_by_source.items())
            },
        }


@dataclass(slots=True)
class MethodOutcome:
    method: str
    status: str  # ok | empty | error | blocked
    detail: str = ""
    items: int = 0
    pages: int = 0

    def as_dict(self) -> dict[str, Any]:
        return {
            "method": self.method,
            "status": self.status,
            "detail": self.detail,
            "items": self.items,
            "pages": self.pages,
        }


