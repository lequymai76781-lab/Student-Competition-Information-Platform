def test_personal_calendar_uses_user_deadline():
    service = PersonalCompetitionService()
    with SessionLocal() as db:
        _cleanup(db, "v1test-cal@example.com")
        user = _user(db, "v1test-cal@example.com")
        _profile(db, user, "西南交通大学", "经济管理学院", "工商管理")
        events = service.upcoming_events(db, user)
        for event in events:
            assert event["deadline"] is not None
        db.rollback()


def test_deadline_revision_full_chain():
    """原9-20 -> 更新9-27：revision保留旧值、event、通知、edition更新、详情数据可用。"""
    service = NotificationService()
    with SessionLocal() as db:
        _cleanup(db, "v1test-chain@example.com")
        user = _user(db, "v1test-chain@example.com")
        _profile(db, user, "西南交通大学", "经济管理学院", "工商管理")
        competitions = list(db.execute(select(Competition).where(Competition.is_demo.is_(False))).scalars())
        competition = next(item for item in competitions if "创新" in item.name)
        db.add(Favorite(user_id=user.id, competition_id=competition.id))
        db.flush()
        edition_rows = [
            edition
            for edition in db.execute(select(CompetitionEdition)).scalars()
            if edition.competition_id == competition.id and edition.year >= 2025
        ]
        edition = max(edition_rows, key=lambda item: item.year) if edition_rows else None
        assert edition is not None
        old = edition.official_registration_deadline or edition.registration_deadline
        new = datetime(2026, 9, 27, 23, 59, tzinfo=timezone.utc)
        if old == new:
            new = datetime(2026, 9, 28, 23, 59, tzinfo=timezone.utc)
        event = service.apply_deadline_update(
            db,
            edition,
            new_deadline=new,
            source_url="https://example.com/official-new",
            source_name="官方通知",
            field_name="official_registration_deadline",
        )
        assert event is not None
        assert event.old_value != event.new_value
        revisions = list(
            db.execute(
                select(CompetitionFactRevision).where(
                    CompetitionFactRevision.competition_edition_id == edition.id,
                    CompetitionFactRevision.field_name == "official_registration_deadline",
                )
            ).scalars()
        )
        assert revisions, "旧值必须以 FactRevision 保留"
        notifications = list(
            db.execute(
                select(Notification).where(
                    Notification.user_id == user.id,
                    Notification.type == "competition_updated",
                )
            ).scalars()
        )
        assert notifications
        # restore original deadline and remove test artifacts
        from app.models import CompetitionUpdateEvent as _Event

        test_events = [
            row
            for row in db.execute(select(_Event)).scalars()
            if row.source_url == "https://example.com/official-new"
        ]
        for event_row in test_events:
            for note in db.execute(select(Notification)).scalars():
                if note.source_event_id == event_row.id:
                    db.delete(note)
            db.delete(event_row)
        for revision in db.execute(select(CompetitionFactRevision)).scalars():
            if revision.source_url == "https://example.com/official-new":
                db.delete(revision)
        edition.official_registration_deadline = old
        db.commit()


def _restore_deadline_test_artifacts(
    db,
    competition_id: int,
    edition_id: int,
    source_url: str,
    old_deadline,
) -> None:
    from app.models import CompetitionUpdateEvent as _Event

    events = [
        row
        for row in db.execute(select(_Event)).scalars()
        if row.competition_id == competition_id and row.source_url == source_url
    ]
    for event_row in events:
        for note in db.execute(select(Notification)).scalars():
            if note.source_event_id == event_row.id:
                db.delete(note)
        db.delete(event_row)
    for revision in db.execute(select(CompetitionFactRevision)).scalars():
        if revision.competition_id == competition_id and revision.source_url == source_url:
            db.delete(revision)
    edition = db.get(CompetitionEdition, edition_id)
    assert edition is not None
    edition.official_registration_deadline = old_deadline
    db.commit()


def test_correction_admin_approve_closes_loop():
    from datetime import datetime as _dt

    from app.api.routes.admin import review_correction
    from app.models import AdminAuditLog

    with SessionLocal() as db:
        _cleanup(db, "v1test-corr-user@example.com")
        _cleanup(db, "v1test-corr-admin@example.com")
        normal = _user(db, "v1test-corr-user@example.com")
        admin = _user(db, "v1test-corr-admin@example.com", admin=True)
        competitions = list(db.execute(select(Competition).where(Competition.is_demo.is_(False))).scalars())
        competition = next(item for item in competitions if "创新" in item.name)
        correction = UserCorrectionSubmission(
            user_id=normal.id,
            competition_id=competition.id,
            correction_type="报名截止错误",
            description="官方截止应为9月27日",
            source_url="https://example.com/notice",
            status="pending",
        )
        db.add(correction)
        db.flush()
        edition = max(
            (
                e
                for e in db.execute(select(CompetitionEdition)).scalars()
                if e.competition_id == competition.id
            ),
            key=lambda item: item.year,
        )
        old_deadline = edition.official_registration_deadline
        review_correction(
            correction.id,
            ReviewActionIn(
                status="approved",
                note="核验通过",
                new_deadline=_dt(2026, 9, 27, 23, 59, tzinfo=timezone.utc),
            ),
            admin,
            db,
        )
        db.refresh(correction)
        assert correction.status == "approved"
        audit_rows = list(db.execute(select(AdminAuditLog)).scalars())
        assert audit_rows
        for audit_row in audit_rows:
            db.delete(audit_row)
        _restore_deadline_test_artifacts(db, competition.id, edition.id, "https://example.com/notice", old_deadline)
        db.rollback()
