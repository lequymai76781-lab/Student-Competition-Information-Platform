[program:competition-backend]
directory=/www/wwwroot/competition/backend
environment=ENVIRONMENT=production
command=/www/wwwroot/competition/backend/venv/bin/gunicorn app.main:app -w 2 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000 --timeout 120
autostart=true
autorestart=true
startsecs=5
stderr_logfile=/www/wwwroot/competition/data/logs/supervisor-backend.err.log
stdout_logfile=/www/wwwroot/competition/data/logs/supervisor-backend.out.log
