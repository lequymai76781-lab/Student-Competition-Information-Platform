import importlib.util
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
SCRIPT = ROOT / "backend/scripts/audit_specialized_completion_final.py"
SPEC = importlib.util.spec_from_file_location("specialized_completion_audit", SCRIPT)
AUDIT = importlib.util.module_from_spec(SPEC)
assert SPEC.loader is not None
SPEC.loader.exec_module(AUDIT)


def load(path: str):
    return json.loads((ROOT / path).read_text(encoding="utf-8"))


def test_final_acceptance_audit_has_no_failures():
    result = AUDIT.run_audit()
    assert result["summary"]["FAIL"] == 0
    assert result["summary"]["PASS"] >= 20


def test_research_and_verified_coverage_are_separate():
    result = AUDIT.run_audit()
    assert result["research_coverage"] == {"covered": 34, "target": 34}
    assert result["verified_data_coverage"] == {"covered": 27, "target": 34}


def test_every_school_has_a_terminal_status_and_archive():
    payload = load("data/checkpoints/specialized_institution_research_archives.json")
    assert payload["research_complete"] is True
    assert len(payload["institutions"]) == 34
    assert all(row["final_status"] in AUDIT.FINAL_STATUSES for row in payload["institutions"])
    assert not any(row["final_status"] == "NEEDS_DEEPER_REVIEW" for row in payload["institutions"])


def test_remaining_22_is_the_fixed_second_round_cohort():
    payload = load("data/checkpoints/SPECIALIZED_REMAINING_22.json")
    assert payload["count"] == 22
    assert len(payload["institutions"]) == 22
    assert len({row["name"] for row in payload["institutions"]}) == 22


def test_manual_qa_has_five_per_category_and_no_uncertain():
    qa = load("data/reports/specialized_institutions_coverage_01_qa.json")
    assert qa["sample_size"] >= 25
    assert qa["summary"] == {"PASS": qa["sample_size"], "FAIL": 0, "UNCERTAIN": 0}
    assert all(qa["category_counts"].get(category, 0) >= 5 for category in AUDIT.CATEGORIES)


def test_two_uncertain_items_are_downgraded():
    result = load("data/reports/specialized_reverse_audit_result.json")
    assert result["uncertain"]["resolved"] == 2
    assert result["uncertain"]["remaining_uncertain"] == 0
    assert {row["result"] for row in result["uncertain"]["outcomes"]} == {"DOWNGRADE"}


def test_previous_13_reverse_review_is_complete():
    result = load("data/reports/specialized_reverse_audit_result.json")["previous_13"]
    assert result["reviewed"] == 13
    assert result["pass_after_correction"] == 12
    assert result["deleted"] == 1


def test_round2_importer_is_idempotent():
    result = load("data/reports/specialized_round2_idempotency.json")
    assert result["passed"] is True
    assert result["semantic_digest_before"] == result["semantic_digest_after"]
    assert all(value == 0 for value in result["importer_stats"].values())


def test_integrity_audits_pass():
    result = AUDIT.run_audit()
    required = {
        "round2_importer_materialization", "official_source_audit", "event_type_audit",
        "relation_audit", "recognition_scope_audit", "professional_reference_evidence",
        "duplicate_competition_audit", "orphan_audit",
    }
    checks = {row["name"]: row["status"] for row in result["checks"]}
    assert required <= checks.keys()
    assert all(checks[name] == "PASS" for name in required)
