ENVIRONMENT=development

# Backend
DATABASE_URL=postgresql+psycopg://competition:competition@localhost:5432/competition_intelligence
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=
MEILISEARCH_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Docker PostgreSQL
POSTGRES_DB=competition_intelligence
POSTGRES_USER=competition
POSTGRES_PASSWORD=competition

APP_SECRET=replace-with-random-secret

# 生产/Beta（禁止默认值；部署时只填变量名和占位）
